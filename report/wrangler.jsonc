// The status report, served as a static page.
//
// A separate Worker on purpose. The production one sits behind Cloudflare
// Access and its bundle is kept deliberately small; a public document has no
// business widening either. Nothing here has a binding, a secret, or a route
// into the agent.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "antiproton-report",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": { "directory": "./public" }
}
