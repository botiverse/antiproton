// Not a program. The type check is two programs, tsconfig.node.json and
// tsconfig.worker.json, and `npm run typecheck` runs both against their own
// baselines; `npx tsc` here checks nothing and exits 0, so do not read that as
// a pass. This file exists so an editor opening the repo finds the two real
// configs instead of inferring a third with none of their settings.
{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.worker.json" }]
}
