{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types"],
    "lib": ["es2022"]
  },
  "include": ["src/**/*.ts", "cf/src/**/*.ts", "test/**/*.ts", "bench/**/*.ts", "report/**/*.ts"],
  "exclude": ["node_modules", "cf/node_modules", "report/node_modules"]
}
