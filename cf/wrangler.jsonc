{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "antiproton",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Two custom hostnames serve this Worker: the original, and antiproton.ai
  // (tygg, 2026-09-11). Both are listed so a deploy adds without removing.
  "routes": [
    { "pattern": "antiproton.botiverse.dev", "custom_domain": true },
    { "pattern": "antiproton.ai", "custom_domain": true }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "AgentDO" }]
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "antiproton-artifacts" }],
  // The only construct on this platform that owns work across invocations.
  // `waitUntil` does not: it is a promise attached to an invocation that has
  // already returned, and the platform cancels it when its budget runs out —
  // which stranded tasks with an unanswered model call and no way back.
  "queues": {
    "producers": [{ "binding": "MODEL_QUEUE", "queue": "antiproton-model" }],
    "consumers": [
      {
        "queue": "antiproton-model",
        // One model call per invocation: batching would make a slow call hold
        // its neighbours, and the wait is the whole cost here.
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        // Then it stops being retried and becomes visible in the dead letter
        // queue, rather than being retried until someone notices the bill.
        "max_retries": 3,
        "dead_letter_queue": "antiproton-model-dlq"
      },
      { "queue": "antiproton-model-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    // The window is looked up from this name rather than configured beside it:
    // the pair was once set to 131072 for a model holding a million, and
    // compaction fired at a twelfth of the context it had.
    "HARNESS_MODEL": "deepseek-flash",
    "ARTIFACT_BUCKET": "antiproton-artifacts",
    // Access now sits in front of antiproton.botiverse.dev; the UI fails closed
    // anywhere without an identity, including the workers.dev address.
    "UI_ALLOW_ANONYMOUS": "0",
    // Login with Raft. The client is registered on our Raft server with this
    // exact callback; the secret and SESSION_SECRET are Worker secrets.
    "RAFT_CLIENT_ID": "antiproton",
    "RAFT_SERVER_ID": "f94d930c-3ef7-45ac-a549-4898b957949f",
    "UI_ORIGIN": "https://antiproton.ai"
  },
  "observability": { "enabled": true }
}
