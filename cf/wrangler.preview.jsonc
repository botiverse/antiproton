{
  // The preview console: the same code as `antiproton`, on its own hostname,
  // with its own objects, bucket and queues and no model, sandbox or sealing
  // keys, so it can render every page and run nothing. Deployed from a branch
  // before merge so a change can be looked at; deleted when it is not needed.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "antiproton-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev until the custom domain exists: attaching antiproton-preview.botiverse.dev
  // needs zone permission this token does not hold, so the domain is added in
  // the dashboard by the account owner (Settings > Domains & Routes).
  "workers_dev": true,
  "routes": [{ "pattern": "preview.antiproton.ai", "custom_domain": true }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentDO"] }],
  "durable_objects": { "bindings": [{ "name": "AGENT", "class_name": "AgentDO" }] },
  "d1_databases": [
    { "binding": "CONTROL_DB", "database_name": "antiproton-preview-control", "database_id": "a0e85fd1-e19a-4a05-a583-c85e3539622a", "migrations_dir": "migrations" }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "antiproton-preview-artifacts" }],
  "queues": {
    "producers": [{ "binding": "MODEL_QUEUE", "queue": "antiproton-preview-model" }],
    "consumers": [
      { "queue": "antiproton-preview-model", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "dead_letter_queue": "antiproton-preview-model-dlq" },
      { "queue": "antiproton-preview-model-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "HARNESS_MODEL": "deepseek-flash",
    // The providers the operator's account reaches (src/model/providers.ts). Each credential is named by
    // its Worker secret, never written here. `cloudflare` is offered once AI_GATEWAY_TOKEN is set; until
    // then it is listed as unavailable. The gateway holds the other vendors' keys, so DeepSeek's is passed
    // through only for deepseek/ models.
    "MODEL_PROVIDERS": [
      { "id": "deepseek", "baseUrl": "https://api.deepseek.com",
        "auth": { "secret": "DEEPSEEK_API_KEY", "header": "authorization" } },
      { "id": "cloudflare", "baseUrl": "https://gateway.ai.cloudflare.com/v1/a084c4564dfdce5a7775b08ece638a79/antiproton-preview/compat",
        "auth": { "secret": "AI_GATEWAY_TOKEN", "header": "cf-aig-authorization" },
        "modelFormat": "vendor/model", "passKeys": { "deepseek/": "DEEPSEEK_API_KEY" } }
    ],
    // What an owner may pick for their own agent (src/model/user-models.ts): an id and a label over a provider
    // above and its model. DeepSeek Flash is the default as well as an option, so an owner can return to it by
    // name; GPT-5.6 Luna is offered only while the cloudflare provider is available (AI_GATEWAY_TOKEN set).
    "USER_MODELS": [
      { "id": "deepseek-flash", "label": "DeepSeek Flash", "provider": "deepseek", "model": "deepseek-flash" },
      { "id": "gpt-5.6-luna", "label": "GPT-5.6 Luna", "provider": "cloudflare", "model": "openai/gpt-5.6-luna" }
    ],
    "ARTIFACT_BUCKET": "antiproton-preview-artifacts",
    "HOOK_ORIGIN": "https://preview.antiproton.ai",
    // Open to look at until the Access application exists; the write routes
    // refuse the anonymous viewer regardless, and there are no keys to spend.
    "UI_ALLOW_ANONYMOUS": "1",
    // Same container lease as production (cf/wrangler.jsonc says why).
    "RUN9_WARN_MINUTES": "5",
    "RUN9_MAX_IDLE_MINUTES": "30",
    // An evaluation's setup routes under /provision (seeded workspace files, fresh context, model-input evidence;
    // cf/src/provision/handlers.ts). Preview only: test/eval-seed.ts fails if cf/wrangler.jsonc sets it.
    "EVAL_SEED_ROUTES": "1"
  },
  "observability": { "enabled": true }
}
